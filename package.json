        "@typescript-eslint/eslint-plugin": "8.26.x",
        "@typescript-eslint/parser": "8.26.x",
        "eslint": "9.21.x",
        "eslint-config-prettier": "9.1.x",
        "eslint-plugin-svelte": "2.46.x",
        "prettier": "3.5.x",
        "prettier-plugin-svelte": "3.3.x",
        "sass": "1.85.x",
        "svelte": "5.25.x",
        "svelte-check": "4.1.x",
        "tslib": "2.8.x",
        "typescript": "5.8.x",
