{
    "name": "@model-w/preset-sveltekit",
    "version": "2025.4.0",
    "type": "module",
    "description": "Preset of Sveltekit for ModelW",
    "license": "WTFPL",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ModelW/preset-sveltekit.git"
    },
    "homepage": "https://github.com/ModelW/preset-sveltekit#readme",
    "bugs": {
        "url": "https://github.com/ModelW/preset-sveltekit/issues"
    },
    "author": "Rémy Sanchez (@xowap)",
    "keywords": [
        "svelte",
        "sveltekit",
        "sveltekit-preset",
        "model-w",
        "modelw"
    ],
    "main": "index.ts",
    "files": [
        "index.ts",
        "README.md",
        "package.json"
    ],
    "scripts": {
