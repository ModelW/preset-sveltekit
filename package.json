        "@typescript-eslint/eslint-plugin": "8.19.x",
        "@typescript-eslint/parser": "8.19.x",
        "eslint": "9.17.x",
        "eslint-config-prettier": "9.1.x",
        "eslint-plugin-svelte": "2.46.x",
        "prettier": "3.4.x",
        "prettier-plugin-svelte": "3.3.x",
        "sass": "1.83.x",
        "svelte": "5.16.x",
        "svelte-check": "4.1.x",
        "tslib": "2.8.x",
        "typescript": "5.7.x",
