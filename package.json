        "@typescript-eslint/eslint-plugin": "8.33.x",
        "@typescript-eslint/parser": "8.33.x",
        "eslint": "9.28.x",
        "eslint-config-prettier": "10.1.x",
        "eslint-plugin-svelte": "3.9.x",
        "prettier": "3.5.x",
        "prettier-plugin-svelte": "3.4.x",
        "sass": "1.89.x",
        "svelte": "5.33.x",
        "svelte-check": "4.2.x",
        "tslib": "2.8.x",
        "typescript": "5.8.x",
        "vite": "6.3.x",
        "vitest": "3.2.x"
